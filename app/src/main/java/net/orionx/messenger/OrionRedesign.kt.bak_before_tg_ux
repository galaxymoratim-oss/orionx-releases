@Composable
private fun XActiveCircleVideo(
    url: String,
    circleSize: androidx.compose.ui.unit.Dp,
    onLongPress: () -> Unit,
    onFinished: () -> Unit,
    onFallbackOpen: () -> Unit,
) {
    val context = LocalContext.current
    var ready by remember(url) { mutableStateOf(false) }
    var failed by remember(url) { mutableStateOf(false) }
    var durationMs by remember(url) { mutableLongStateOf(0L) }
    var positionMs by remember(url) { mutableLongStateOf(0L) }
    var paused by remember(url) { mutableStateOf(false) }
    val player = remember(url) {
        androidx.media3.exoplayer.ExoPlayer.Builder(context).build().apply {
            volume = 1f
            playWhenReady = true
            repeatMode = androidx.media3.common.Player.REPEAT_MODE_OFF
            setMediaItem(androidx.media3.common.MediaItem.fromUri(url))
            addListener(object : androidx.media3.common.Player.Listener {
                override fun onPlaybackStateChanged(playbackState: Int) {
                    ready = playbackState == androidx.media3.common.Player.STATE_READY
                }
                override fun onPlayerError(error: androidx.media3.common.PlaybackException) {
                    failed = true
                    ready = false
                }
            })
            prepare()
        }
    }
    DisposableEffect(player) { onDispose { player.release() } }

    LaunchedEffect(player) {
        while (true) {
            positionMs = player.currentPosition.coerceAtLeast(0L)
            if (durationMs <= 0L) durationMs = player.duration.takeIf { it > 0L } ?: 0L
            if (player.playbackState == androidx.media3.common.Player.STATE_ENDED) {
                onFinished()
                break
            }
            delay(60)
        }
    }

    val progress = if (durationMs > 0L) (positionMs.toFloat() / durationMs).coerceIn(0f, 1f) else 0f
    Box(
        modifier = Modifier
            .size(circleSize)
            .clip(CircleShape)
            .background(Color(0xFF0B0D1D))
            .combinedClickable(
                onClick = {
                    paused = !paused
                    player.playWhenReady = !paused
                },
                onLongClick = onLongPress,
            ),
        contentAlignment = Alignment.Center,
    ) {
        AndroidView(
            factory = { viewContext ->
                val view = android.view.LayoutInflater.from(viewContext).inflate(R.layout.view_circle_player, null) as androidx.media3.ui.PlayerView
                view.player = player
                view.clipToOutline = true
                view.outlineProvider = object : android.view.ViewOutlineProvider() {
                    override fun getOutline(target: android.view.View, outline: android.graphics.Outline) {
                        outline.setOval(0, 0, target.width, target.height)
                    }
                }
                view
            },
            update = { it.player = player },
            modifier = Modifier.matchParentSize(),
        )

        Canvas(Modifier.matchParentSize().padding(2.dp)) {
            val stroke = 3.dp.toPx()
            val arcSize = Size(size.width - stroke, size.height - stroke)
            val topLeft = Offset(stroke / 2f, stroke / 2f)
            drawArc(
                color = Color.White.copy(alpha = .22f),
                startAngle = 0f,
                sweepAngle = 360f,
                useCenter = false,
                topLeft = topLeft,
                size = arcSize,
                style = Stroke(width = stroke, cap = StrokeCap.Round),
            )
            if (progress > 0f) {
                drawArc(
                    color = Color.White,
                    startAngle = -90f,
                    sweepAngle = progress * 360f,
                    useCenter = false,
                    topLeft = topLeft,
                    size = arcSize,
                    style = Stroke(width = stroke, cap = StrokeCap.Round),
                )
            }
        }

        when {
            failed -> Surface(color = Color.Black.copy(alpha = .56f), shape = CircleShape, modifier = Modifier.clickable(onClick = onFallbackOpen)) {
                Icon(Icons.Outlined.OpenInNew, "Открыть видео", tint = Color.White, modifier = Modifier.padding(14.dp).size(26.dp))
            }
            !ready -> CircularProgressIndicator(color = XViolet, strokeWidth = 2.dp, modifier = Modifier.size(30.dp))
            paused -> Surface(color = Color.Black.copy(alpha = .40f), shape = CircleShape) {
                Icon(Icons.Outlined.PlayArrow, "Продолжить", tint = Color.White, modifier = Modifier.padding(11.dp).size(30.dp))
            }
            else -> Unit
        }

        Surface(
            color = Color.Black.copy(alpha = .70f),
            shape = RoundedCornerShape(50),
            border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .12f)),
            modifier = Modifier.align(Alignment.BottomStart).padding(start = 8.dp, bottom = 8.dp),
        ) {
            Row(Modifier.padding(horizontal = 9.dp, vertical = 5.dp), verticalAlignment = Alignment.CenterVertically) {
                Text(
                    if (durationMs > 0L) formatCircleDuration((durationMs - positionMs).coerceAtLeast(0L).toInt()) else "00:00",
                    color = Color.White,
                    fontSize = 12.sp,
                    fontWeight = FontWeight.Bold,
                )
                Spacer(Modifier.width(5.dp))
                Icon(Icons.Outlined.VolumeUp, null, tint = Color.White.copy(alpha = .95f), modifier = Modifier.size(13.dp))
            }
        }
    }
}

@Composable
private fun XVideoCirclePlayerDialog(
    url: String,
    senderName: String,
    sentAt: String,
    onDismiss: () -> Unit,
    onForward: (() -> Unit)? = null,
    onFinished: (() -> Unit)? = null,
) {
    val context = LocalContext.current
    val player = remember(url) {
        androidx.media3.exoplayer.ExoPlayer.Builder(context).build().apply {
            setMediaItem(androidx.media3.common.MediaItem.fromUri(url))
            repeatMode = androidx.media3.common.Player.REPEAT_MODE_OFF
            volume = 1f
            playWhenReady = true
            prepare()
        }
    }
    var ready by remember(url) { mutableStateOf(false) }
    var failed by remember(url) { mutableStateOf(false) }
    var playing by remember(url) { mutableStateOf(true) }
    var positionMs by remember(url) { mutableLongStateOf(0L) }
    var durationMs by remember(url) { mutableLongStateOf(1L) }
    var muted by remember(url) { mutableStateOf(false) }
    var speed by remember(url) { mutableFloatStateOf(1f) }
    var entered by remember { mutableStateOf(false) }
    var endedHandled by remember(url) { mutableStateOf(false) }

    DisposableEffect(player) {
        val listener = object : androidx.media3.common.Player.Listener {
            override fun onPlaybackStateChanged(playbackState: Int) {
                ready = playbackState == androidx.media3.common.Player.STATE_READY
            }

            override fun onPlayerError(error: androidx.media3.common.PlaybackException) {
                failed = true
                ready = false
                playing = false
            }
        }
        player.addListener(listener)
        onDispose {
            player.removeListener(listener)
            player.release()
        }
    }

    LaunchedEffect(Unit) { entered = true }
    LaunchedEffect(player) {
        while (true) {
            ready = player.playbackState == androidx.media3.common.Player.STATE_READY
            playing = player.isPlaying
            positionMs = player.currentPosition.coerceAtLeast(0L)
            durationMs = player.duration.takeIf { it > 0L } ?: durationMs
            if (player.playbackState == androidx.media3.common.Player.STATE_ENDED && !endedHandled) {
                endedHandled = true
                if (onFinished != null) onFinished() else player.seekTo(0L)
            }
            delay(80)
        }
    }

    fun togglePlayback() {
        if (!ready || failed) return
        if (player.isPlaying) {
            player.pause()
        } else {
            if (durationMs > 1L && positionMs >= durationMs - 250L) player.seekTo(0L)
            player.play()
        }
        playing = player.isPlaying
    }

    fun cycleSpeed() {
        speed = when (speed) {
            1f -> 1.5f
            1.5f -> 2f
            else -> 1f
        }
        player.setPlaybackSpeed(speed)
    }

    Dialog(
        onDismissRequest = onDismiss,
        properties = DialogProperties(
            usePlatformDefaultWidth = false,
            dismissOnClickOutside = false,
            decorFitsSystemWindows = false,
        ),
    ) {
        BoxWithConstraints(
            Modifier
                .fillMaxSize()
                .background(Color.Black.copy(alpha = .76f))
                .statusBarsPadding()
                .navigationBarsPadding(),
        ) {
            val finalSize = minOf(maxWidth - 28.dp, 382.dp)
            val circleSize by animateDpAsState(
                targetValue = if (entered) finalSize else 190.dp,
                animationSpec = tween(340, easing = FastOutSlowInEasing),
                label = "video-circle-expand",
            )
            val circleAlpha by animateFloatAsState(
                targetValue = if (entered) 1f else 0f,
                animationSpec = tween(260),
                label = "video-circle-alpha",
            )

            Column(
                Modifier.fillMaxSize().padding(horizontal = 12.dp, vertical = 10.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
            ) {
                Surface(
                    color = XSurface.copy(alpha = .92f),
                    shape = RoundedCornerShape(24.dp),
                    border = androidx.compose.foundation.BorderStroke(1.dp, XBorder),
                    modifier = Modifier.fillMaxWidth(),
                ) {
                    Row(
                        Modifier.fillMaxWidth().height(58.dp).padding(start = 12.dp, end = 4.dp),
                        verticalAlignment = Alignment.CenterVertically,
                    ) {
                        Icon(
                            if (playing) Icons.Outlined.Pause else Icons.Outlined.PlayArrow,
                            null,
                            tint = XCyan,
                            modifier = Modifier.size(25.dp),
                        )
                        Spacer(Modifier.width(9.dp))
                        Column(Modifier.weight(1f)) {
                            Text(senderName.ifBlank { "Видеокружок" }, color = XText, fontSize = 15.sp, fontWeight = FontWeight.Bold, maxLines = 1)
                            if (sentAt.isNotBlank()) Text(sentAt, color = XMuted, fontSize = 11.sp)
                        }
                        Surface(onClick = { cycleSpeed() }, color = XSurfaceRaised, shape = RoundedCornerShape(10.dp)) {
                            Text(
                                if (speed == 1f) "1×" else "${speed}×",
                                color = XText,
                                fontSize = 11.sp,
                                fontWeight = FontWeight.Bold,
                                modifier = Modifier.padding(horizontal = 9.dp, vertical = 6.dp),
                            )
                        }
                        IconButton(onClick = onDismiss) {
                            Icon(Icons.Outlined.Close, "Закрыть", tint = XMuted)
                        }
                    }
                }

                Spacer(Modifier.weight(1f))
                Box(
                    Modifier
                        .size(circleSize)
                        .graphicsLayer { alpha = circleAlpha }
                        .clip(CircleShape)
                        .background(Color.Black)
                        .border(1.dp, Color.White.copy(alpha = .34f), CircleShape),
                    contentAlignment = Alignment.Center,
                ) {
                    AndroidView(
                        factory = { viewContext ->
                            val view = android.view.LayoutInflater.from(viewContext).inflate(R.layout.view_circle_player, null) as androidx.media3.ui.PlayerView
                            view.player = player
                            view.clipToOutline = true
                            view.outlineProvider = object : android.view.ViewOutlineProvider() {
                                override fun getOutline(target: android.view.View, outline: android.graphics.Outline) {
                                    outline.setOval(0, 0, target.width, target.height)
                                }
                            }
                            view
                        },
                        update = { it.player = player },
                        modifier = Modifier.matchParentSize(),
                    )
                    Box(
                        Modifier
                            .matchParentSize()
                            .pointerInput(durationMs) {
                                detectTapGestures { offset ->
                                    val cx = size.width / 2f
                                    val cy = size.height / 2f
                                    val dx = offset.x - cx
                                    val dy = offset.y - cy
                                    val dist = kotlin.math.hypot(dx.toDouble(), dy.toDouble())
                                    val outer = (minOf(size.width, size.height) / 2f)
                                    if (dist > outer * 0.70f && durationMs > 1L) {
                                        var fromTop = Math.toDegrees(kotlin.math.atan2(dy.toDouble(), dx.toDouble())) + 90.0
                                        if (fromTop < 0.0) fromTop += 360.0
                                        val frac = (fromTop / 360.0).coerceIn(0.0, 1.0)
                                        player.seekTo((frac * durationMs).toLong())
                                        if (!player.isPlaying) player.play()
                                    } else {
                                        togglePlayback()
                                    }
                                }
                            }
                    )
                    Canvas(Modifier.matchParentSize().padding(4.dp)) {
                        val stroke = 4.dp.toPx()
                        val arcSize = Size(size.width - stroke, size.height - stroke)
                        val topLeft = Offset(stroke / 2f, stroke / 2f)
                        drawArc(
                            color = Color.White.copy(alpha = .22f),
                            startAngle = -90f,
                            sweepAngle = 360f,
                            useCenter = false,
                            topLeft = topLeft,
                            size = arcSize,
                            style = Stroke(stroke, cap = StrokeCap.Round),
                        )
                        drawArc(
                            color = Color.White,
                            startAngle = -90f,
                            sweepAngle = 360f * (positionMs.toFloat() / durationMs.toFloat()).coerceIn(0f, 1f),
                            useCenter = false,
                            topLeft = topLeft,
                            size = arcSize,
                            style = Stroke(stroke, cap = StrokeCap.Round),
                        )
                    }
                    when {
                        failed -> Surface(color = Color.Black.copy(alpha = .64f), shape = CircleShape) {
                            Icon(Icons.Outlined.ErrorOutline, "Ошибка воспроизведения", tint = Color.White, modifier = Modifier.padding(17.dp).size(33.dp))
                        }
                        !ready -> CircularProgressIndicator(color = Color.White, strokeWidth = 3.dp, modifier = Modifier.size(42.dp))
                        !playing -> Surface(color = Color.Black.copy(alpha = .50f), shape = CircleShape) {
                            Icon(Icons.Outlined.PlayArrow, "Продолжить", tint = Color.White, modifier = Modifier.padding(15.dp).size(39.dp))
                        }
                    }
                    Surface(
                        color = Color.Black.copy(alpha = .72f),
                        shape = RoundedCornerShape(50),
                        border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .14f)),
                        modifier = Modifier.align(Alignment.BottomStart).padding(start = 20.dp, bottom = 18.dp),
                    ) {
                        Text(
                            "${formatCircleDuration(positionMs.toInt())} / ${formatCircleDuration(durationMs.toInt())}",
                            color = Color.White,
                            fontSize = 13.sp,
                            fontWeight = FontWeight.Bold,
                            modifier = Modifier.padding(horizontal = 10.dp, vertical = 6.dp),
                        )
                    }
                    if (sentAt.isNotBlank()) {
                        Surface(
                            color = Color.Black.copy(alpha = .72f),
                            shape = RoundedCornerShape(50),
                            border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .14f)),
                            modifier = Modifier.align(Alignment.BottomEnd).padding(end = 20.dp, bottom = 18.dp),
                        ) {
                            Row(Modifier.padding(horizontal = 10.dp, vertical = 6.dp), verticalAlignment = Alignment.CenterVertically) {
                                Text(sentAt, color = Color.White, fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
                                Spacer(Modifier.width(4.dp))
                                Icon(Icons.Outlined.DoneAll, null, tint = Color.White, modifier = Modifier.size(18.dp))
                            }
                        }
                    }
                }
                Spacer(Modifier.weight(1f))

                Row(
                    Modifier.padding(bottom = 8.dp),
                    horizontalArrangement = Arrangement.spacedBy(12.dp),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Surface(
                        onClick = {
                            muted = !muted
                            player.volume = if (muted) 0f else 1f
                        },
                        color = XSurface.copy(alpha = .92f),
                        shape = CircleShape,
                        modifier = Modifier.size(50.dp),
                    ) {
                        Box(contentAlignment = Alignment.Center) {
                            Icon(if (muted) Icons.Outlined.VolumeOff else Icons.Outlined.VolumeUp, "Звук", tint = XText)
                        }
                    }
                    Surface(
                        onClick = { togglePlayback() },
                        color = XPurple,
                        shape = CircleShape,
                        shadowElevation = 8.dp,
                        modifier = Modifier.size(62.dp),
                    ) {
                        Box(contentAlignment = Alignment.Center) {
                            Icon(if (playing) Icons.Outlined.Pause else Icons.Outlined.PlayArrow, "Воспроизведение", tint = Color.White, modifier = Modifier.size(31.dp))
                        }
                    }
                    if (onForward != null) {
                        Surface(onClick = onForward, color = XSurface.copy(alpha = .92f), shape = CircleShape, modifier = Modifier.size(50.dp)) {
                            Box(contentAlignment = Alignment.Center) {
                                Icon(Icons.AutoMirrored.Outlined.Forward, "Переслать", tint = XText)
                            }
                        }
                    }
                }
            }
        }
    }
}

private fun formatMediaDuration(milliseconds: Int): String {
    val totalSeconds = (milliseconds.coerceAtLeast(0) / 1000)
    return "%d:%02d".format(totalSeconds / 60, totalSeconds % 60)
}

private fun formatCircleDuration(milliseconds: Int): String {
    val totalSeconds = milliseconds.coerceAtLeast(0) / 1_000
    return "%02d:%02d".format(totalSeconds / 60, totalSeconds % 60)
}

