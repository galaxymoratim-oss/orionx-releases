            lineTo(s * .42f, s * .56f)
            quadraticBezierTo(s * .31f, s * .53f, s * .31f, s * .35f)
            close()
        }
        drawPath(bubble, Brush.linearGradient(listOf(Color(0xFFA276FF), Color(0xFF6E35FF), Color(0xFF4C21C8))))
        drawPath(bubble, Color.White.copy(alpha = .28f), style = Stroke(s * .010f))
