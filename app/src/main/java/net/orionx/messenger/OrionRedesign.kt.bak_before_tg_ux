@Composable
private fun XComposerCircleButton(
    icon: ImageVector? = null,
    iconRes: Int? = null,
    description: String,
    active: Boolean,
    danger: Boolean = false,
    size: Dp = 46.dp,
    onLongClick: (() -> Unit)? = null,
    onHoldStart: (() -> Unit)? = null,
    onHoldLock: (() -> Unit)? = null,
    onHoldCancel: (() -> Unit)? = null,
    onHoldSend: (() -> Unit)? = null,
    onHoldMove: ((Float, Float) -> Unit)? = null,
    onClick: () -> Unit,
) {
    val density = LocalDensity.current
    val lockPx = with(density) { 64.dp.toPx() }
    val cancelPx = with(density) { 96.dp.toPx() }
    val gesture = if (onHoldStart != null) {
        Modifier.pointerInput(active) {
            if (!active) return@pointerInput
            kotlinx.coroutines.coroutineScope {
                while (true) {
                    val down = awaitPointerEventScope { awaitFirstDown(requireUnconsumed = false) }
                    var started = false
                    var locked = false
                    var cancelled = false
                    var dx = 0f
                    var dy = 0f
                    val timer = launch {
                        delay(150)
                        if (!started) { started = true; onHoldStart() }
                    }
                    awaitPointerEventScope {
                        while (true) {
                            val ev = awaitPointerEvent()
                            val ch = ev.changes.firstOrNull { it.id == down.id }
                            if (ch == null || !ch.pressed) break
                            val pc = ch.positionChange()
                            dx += pc.x
                            dy += pc.y
                            if (!started && (dx * dx + dy * dy) > 900f) {
                                started = true
                                timer.cancel()
                                onHoldStart()
                            }
                            if (started) {
                                onHoldMove?.invoke(dx, dy)
                                if (!locked && dy < -lockPx) { locked = true; onHoldLock?.invoke() }
                                if (!cancelled && !locked && dx < -cancelPx) { cancelled = true; onHoldCancel?.invoke() }
                            }
                            ch.consume()
                            if (cancelled) break
                        }
                    }
                    timer.cancel()
                    if (!started) {
                        onClick()
                    } else if (!locked && !cancelled) {
                        onHoldSend?.invoke()
                    }
                }
            }
        }
    } else if (onLongClick != null) {
        Modifier.combinedClickable(enabled = active, onClick = onClick, onLongClick = onLongClick)
    } else {
        Modifier.clickable(enabled = active, onClick = onClick)
    }
    Surface(
        color = when {
            !active -> XSurfaceRaised
            danger -> XRed.copy(alpha = .82f)
            else -> XPurple
        },
        shape = CircleShape,
        modifier = Modifier.size(size).then(gesture),
    ) {
        Box(contentAlignment = Alignment.Center) {
            val tint = if (active) Color.White else XMuted
            if (iconRes != null) {
                Icon(painterResource(iconRes), description, tint = tint, modifier = Modifier.size(size * .48f))
            } else if (icon != null) {
                Icon(icon, description, tint = tint, modifier = Modifier.size(size * .48f))
            }
        }
    }
}

@Composable
private fun XInlineCircleRecorder(
    stopTick: Int,
    cancelTick: Int,
    locked: Boolean,
    dragProgress: Float,
    onElapsed: (Long) -> Unit,
    onCaptured: (File) -> Unit,
    onCancelled: () -> Unit,
    onError: (String) -> Unit,
    onTapSend: (() -> Unit)? = null,
) {
    val context = LocalContext.current
    val lifecycleOwner = context as? androidx.lifecycle.LifecycleOwner
    if (lifecycleOwner == null) {
        LaunchedEffect(Unit) { onError("Камера недоступна на этом устройстве"); onCancelled() }
        return
    }
    val executor = remember(context) { ContextCompat.getMainExecutor(context) }
    val recorder = remember { Recorder.Builder().build() }
    val previewView = remember(context) {
        PreviewView(context).apply {
            scaleType = PreviewView.ScaleType.FILL_CENTER
            implementationMode = PreviewView.ImplementationMode.COMPATIBLE
            clipToOutline = true
            outlineProvider = object : android.view.ViewOutlineProvider() {
                override fun getOutline(target: android.view.View, outline: android.graphics.Outline) {
                    outline.setOval(0, 0, target.width, target.height)
                }
            }
        }
    }
    var videoCapture by remember { mutableStateOf<VideoCapture<Recorder>?>(null) }
    var boundCamera by remember { mutableStateOf<androidx.camera.core.Camera?>(null) }
    var recording by remember { mutableStateOf<Recording?>(null) }
    var recordedFile by remember { mutableStateOf<File?>(null) }
    var cancelRequested by remember { mutableStateOf(false) }
    var elapsedMs by remember { mutableLongStateOf(0L) }
    var cameraReady by remember { mutableStateOf(false) }
    var started by remember { mutableStateOf(false) }

    DisposableEffect(lifecycleOwner) {
        cameraReady = false
        val future = ProcessCameraProvider.getInstance(context)
        val listener = Runnable {
            runCatching {
                val provider = future.get()
                val preview = Preview.Builder().build().also { it.setSurfaceProvider(previewView.surfaceProvider) }
                val capture = VideoCapture.withOutput(recorder)
                val selector = CameraSelector.Builder().requireLensFacing(CameraSelector.LENS_FACING_FRONT).build()
                provider.unbindAll()
                boundCamera = provider.bindToLifecycle(lifecycleOwner, selector, preview, capture)
                videoCapture = capture
                cameraReady = true
            }.onFailure {
                boundCamera = null
                cameraReady = false
                onError("Не удалось запустить камеру")
            }
        }
        future.addListener(listener, executor)
        onDispose {
            boundCamera = null
            runCatching { if (future.isDone) future.get().unbindAll() }
        }
    }

    fun startRecording() {
        if (recording != null) return
        val capture = videoCapture ?: return
        runCatching {
            val directory = File(context.cacheDir, "video_messages").apply { mkdirs() }
            val file = File(directory, "video_circle_${System.currentTimeMillis()}.mp4")
            recordedFile = file
            cancelRequested = false
            elapsedMs = 0L
            val output = FileOutputOptions.Builder(file).build()
            val prepared = capture.output.prepareRecording(context, output)
            val pending = if (ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED) {
                prepared.withAudioEnabled()
            } else {
                prepared
            }
            recording = pending.asPersistentRecording().start(executor) { event ->
                if (event is VideoRecordEvent.Finalize) {
                    val finished = recordedFile
                    recording = null
                    recordedFile = null
                    if (event.hasError()) {
                        finished?.delete(); onError("Не удалось сохранить видеосообщение")
                    } else if (cancelRequested) {
                        finished?.delete(); onCancelled()
                    } else if (finished != null && finished.exists() && finished.length() > 0L) {
                        onCaptured(finished)
                    } else {
                        onError("Видеосообщение не записалось")
                    }
                }
            }
        }.onFailure {
            recording = null
            recordedFile?.delete()
            recordedFile = null
            onError("Не удалось начать запись видеосообщения")
        }
    }

    LaunchedEffect(cameraReady) {
        if (cameraReady && !started) { started = true; startRecording() }
    }
    LaunchedEffect(recording) {
        val active = recording ?: return@LaunchedEffect
        val startedAt = SystemClock.elapsedRealtime()
        while (recording === active) {
            elapsedMs = (SystemClock.elapsedRealtime() - startedAt).coerceAtLeast(0L)
            onElapsed(elapsedMs)
            if (elapsedMs >= 60_000L) { active.stop(); break }
            delay(80)
        }
    }
    LaunchedEffect(stopTick) {
        if (stopTick > 0) { recording?.stop() }
    }
    LaunchedEffect(cancelTick) {
        if (cancelTick > 0) {
            cancelRequested = true
            val active = recording
            if (active != null) active.stop() else onCancelled()
        }
    }

    val cancelling = dragProgress < -0.15f
    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Box(
            Modifier
                .size(172.dp)
                .clip(CircleShape)
                .background(Color.Black)
                .border(3.dp, if (cancelling) Color(0xFFF04452) else if (locked) XViolet else Color.White.copy(alpha = .92f), CircleShape),
            contentAlignment = Alignment.Center,
        ) {
            AndroidView(factory = { previewView }, modifier = Modifier.matchParentSize().clip(CircleShape))
            Canvas(Modifier.matchParentSize().padding(3.dp)) {
                val stroke = 3.dp.toPx()
                val sweep = (elapsedMs.coerceAtMost(60_000L) / 60_000f) * 360f
                drawArc(
                    color = Color(0xFFF04452),
                    startAngle = -90f,
                    sweepAngle = sweep,
                    useCenter = false,
                    topLeft = Offset(stroke / 2f, stroke / 2f),
                    size = Size(size.width - stroke, size.height - stroke),
                    style = Stroke(width = stroke, cap = StrokeCap.Round),
                )
            }
            if (!cameraReady) CircularProgressIndicator(color = Color.White, modifier = Modifier.size(30.dp))
            if (locked) {
                Box(Modifier.align(Alignment.TopEnd).padding(10.dp).size(26.dp).clip(CircleShape).background(Color.Black.copy(alpha = .5f)), contentAlignment = Alignment.Center) {
                    Icon(Icons.Outlined.Lock, "Зафиксировано", tint = Color.White, modifier = Modifier.size(16.dp))
                }
            }
        }
        Spacer(Modifier.height(10.dp))
        Row(verticalAlignment = Alignment.CenterVertically) {
            Box(Modifier.size(8.dp).clip(CircleShape).background(Color(0xFFF04452)))
            Spacer(Modifier.width(6.dp))
            Text(formatCircleDuration(elapsedMs.toInt()), color = Color.White, fontSize = 14.sp, fontWeight = FontWeight.SemiBold)
        }
        Spacer(Modifier.height(4.dp))
        Text(
            when {
                cancelling -> "Отпустите для отмены"
                locked -> "Зафиксировано · нажмите отправить"
                else -> "‹ влево — отмена   ·   ⌃ вверх — зафиксировать"
            },
            color = if (cancelling) Color(0xFFF04452) else Color.White.copy(alpha = .72f),
            fontSize = 11.sp,
        )
        if (locked) {
            Spacer(Modifier.height(10.dp))
            Surface(
                color = XPurple,
                shape = CircleShape,
                modifier = Modifier.size(52.dp).clickable { onTapSend?.invoke() },
            ) {
                Box(contentAlignment = Alignment.Center) {
                    Icon(painterResource(R.drawable.ic_send), "Отправить", tint = Color.White, modifier = Modifier.size(24.dp))
                }
            }
        }
    }
}

@Composable
private fun XVideoCircleRecorderDialog(
    autoStart: Boolean,
    onDismiss: () -> Unit,
    onCaptured: (File) -> Unit,
    onError: (String) -> Unit,
) {
    val context = LocalContext.current
    val lifecycleOwner = context as? androidx.lifecycle.LifecycleOwner
    if (lifecycleOwner == null) {
        LaunchedEffect(Unit) {
            onError("Не удалось открыть камеру на этом устройстве")
            onDismiss()
        }
        return
    }
    val executor = remember(context) { ContextCompat.getMainExecutor(context) }
    val recorder = remember { Recorder.Builder().build() }
    val previewView = remember(context) {
        PreviewView(context).apply {
            scaleType = PreviewView.ScaleType.FILL_CENTER
            implementationMode = PreviewView.ImplementationMode.COMPATIBLE
            clipToOutline = true
            outlineProvider = object : android.view.ViewOutlineProvider() {
                override fun getOutline(target: android.view.View, outline: android.graphics.Outline) {
                    outline.setOval(0, 0, target.width, target.height)
                }
            }
        }
    }
    var lensFacing by remember { mutableIntStateOf(CameraSelector.LENS_FACING_FRONT) }
    var videoCapture by remember { mutableStateOf<VideoCapture<Recorder>?>(null) }
    var boundCamera by remember { mutableStateOf<androidx.camera.core.Camera?>(null) }
    var recording by remember { mutableStateOf<Recording?>(null) }
    var recordedFile by remember { mutableStateOf<File?>(null) }
    var cancelRequested by remember { mutableStateOf(false) }
    var elapsedMs by remember { mutableLongStateOf(0L) }
    var cameraReady by remember { mutableStateOf(false) }
    var torchEnabled by remember { mutableStateOf(false) }
    var locked by remember { mutableStateOf(false) }
    var swipeOffset by remember { mutableFloatStateOf(0f) }
    var autoStartConsumed by remember(autoStart) { mutableStateOf(false) }
    val swipeCancelThreshold = with(LocalDensity.current) { 92.dp.toPx() }

    val pulseTransition = rememberInfiniteTransition(label = "video-record-pulse")
    val recordPulse by pulseTransition.animateFloat(
        initialValue = 1f,
        targetValue = 1.13f,
        animationSpec = infiniteRepeatable(tween(880, easing = FastOutSlowInEasing), repeatMode = RepeatMode.Reverse),
        label = "video-record-pulse-scale",
    )

    DisposableEffect(lifecycleOwner, lensFacing) {
        cameraReady = false
        torchEnabled = false
        val future = ProcessCameraProvider.getInstance(context)
        val listener = Runnable {
            runCatching {
                val provider = future.get()
                val preview = Preview.Builder().build().also { it.setSurfaceProvider(previewView.surfaceProvider) }
                val capture = VideoCapture.withOutput(recorder)
                val selector = CameraSelector.Builder().requireLensFacing(lensFacing).build()
                provider.unbindAll()
                boundCamera = provider.bindToLifecycle(lifecycleOwner, selector, preview, capture)
                videoCapture = capture
                cameraReady = true
            }.onFailure {
                boundCamera = null
                cameraReady = false
                onError("Не удалось запустить камеру")
            }
        }
        future.addListener(listener, executor)
        onDispose {
            runCatching { boundCamera?.cameraControl?.enableTorch(false) }
            boundCamera = null
            runCatching { if (future.isDone) future.get().unbindAll() }
        }
    }

    LaunchedEffect(recording) {
        val active = recording ?: return@LaunchedEffect
        val startedAt = SystemClock.elapsedRealtime()
        while (recording === active) {
            elapsedMs = (SystemClock.elapsedRealtime() - startedAt).coerceAtLeast(0L)
            if (elapsedMs >= 60_000L) {
                active.stop()
                break
            }
            delay(100)
        }
    }

    fun stopAndDiscard() {
        cancelRequested = true
        val active = recording
        if (active != null) {
            active.stop()
        } else {
            recordedFile?.delete()
            onDismiss()
        }
    }

    fun toggleRecording() {
        val active = recording
        if (active != null) {
            active.stop()
            return
        }
        val capture = videoCapture ?: run {
            onError("Камера ещё загружается")
            return
        }
        runCatching {
            val directory = File(context.cacheDir, "video_messages").apply { mkdirs() }
            val file = File(directory, "video_circle_${System.currentTimeMillis()}.mp4")
            recordedFile = file
            cancelRequested = false
            elapsedMs = 0L
            locked = false
            swipeOffset = 0f
            val output = FileOutputOptions.Builder(file).build()
            val preparedRecording = capture.output.prepareRecording(context, output)
            val pending = if (ContextCompat.checkSelfPermission(
                    context,
                    Manifest.permission.RECORD_AUDIO,
                ) == PackageManager.PERMISSION_GRANTED
            ) {
                preparedRecording.withAudioEnabled()
            } else {
                preparedRecording
            }
            recording = pending.asPersistentRecording().start(executor) { event ->
                if (event is VideoRecordEvent.Finalize) {
                    val finished = recordedFile
                    recording = null
                    recordedFile = null
                    if (event.hasError()) {
                        finished?.delete()
                        onError("Не удалось сохранить видеосообщение")
                    } else if (cancelRequested) {
                        finished?.delete()
                        onDismiss()
                    } else if (finished != null && finished.exists() && finished.length() > 0L) {
                        onCaptured(finished)
                    } else {
                        onError("Видеосообщение не записалось")
                    }
                }
            }
        }.onFailure {
            recording = null
            recordedFile?.delete()
            recordedFile = null
            onError("Не удалось начать запись видеосообщения")
        }
    }

    LaunchedEffect(cameraReady, autoStart) {
        if (autoStart && cameraReady && !autoStartConsumed && recording == null) {
            autoStartConsumed = true
            toggleRecording()
        }
    }

    fun toggleTorch() {
        if (lensFacing == CameraSelector.LENS_FACING_FRONT) return
        val next = !torchEnabled
        runCatching { boundCamera?.cameraControl?.enableTorch(next) }
            .onSuccess { torchEnabled = next }
            .onFailure { onError("Не удалось переключить вспышку") }
    }

    val timerText = remember(elapsedMs) {
        val totalSeconds = elapsedMs / 1_000L
        val tenth = (elapsedMs % 1_000L) / 100L
        "%02d:%02d,%d".format(totalSeconds / 60L, totalSeconds % 60L, tenth)
    }

    Dialog(
        onDismissRequest = { stopAndDiscard() },
        properties = DialogProperties(
            usePlatformDefaultWidth = false,
            dismissOnClickOutside = false,
            decorFitsSystemWindows = false,
        ),
    ) {
        BoxWithConstraints(
            Modifier
                .fillMaxSize()
                .background(Color(0xF2050A16))
                .statusBarsPadding()
                .navigationBarsPadding(),
        ) {
            val previewSize = minOf(maxWidth - 24.dp, maxHeight * .62f, 390.dp)
            val progress = (elapsedMs.toFloat() / 60_000f).coerceIn(0f, 1f)
            val recordingNow = recording != null

            Surface(
                onClick = { stopAndDiscard() },
                color = Color.Black.copy(alpha = .52f),
                shape = CircleShape,
                border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .18f)),
                modifier = Modifier.align(Alignment.TopEnd).padding(16.dp).size(44.dp),
            ) {
                Box(contentAlignment = Alignment.Center) {
                    Icon(Icons.Outlined.Close, "Закрыть", tint = Color.White, modifier = Modifier.size(23.dp))
                }
            }

            Box(
                Modifier
                    .align(Alignment.Center)
                    .offset(y = (-32).dp)
                    .size(previewSize)
                    .clip(CircleShape)
                    .background(Color.Black)
                    .pointerInput(recordingNow, locked) {
                        if (recordingNow && !locked) {
                            var acc = 0f
                            detectVerticalDragGestures(
                                onDragStart = { acc = 0f },
                                onDragEnd = { acc = 0f },
                                onDragCancel = { acc = 0f },
                            ) { change, dy ->
                                change.consume()
                                acc += dy
                                if (acc <= -70f) locked = true
                            }
                        }
                    }
                    .border(2.dp, if (recordingNow) Color.White.copy(alpha = .82f) else XViolet, CircleShape),
                contentAlignment = Alignment.Center,
            ) {
                AndroidView(
                    factory = { previewView },
                    modifier = Modifier.matchParentSize(),
                )
                Canvas(Modifier.matchParentSize().padding(5.dp)) {
                    val stroke = 3.dp.toPx()
                    val arcSize = Size(size.width - stroke, size.height - stroke)
                    val topLeft = Offset(stroke / 2f, stroke / 2f)
                    drawArc(
                        color = Color.White.copy(alpha = .18f),
                        startAngle = -90f,
                        sweepAngle = 360f,
                        useCenter = false,
                        topLeft = topLeft,
                        size = arcSize,
                        style = Stroke(stroke, cap = StrokeCap.Round),
                    )
                    drawArc(
                        color = Color.White,
                        startAngle = -90f,
                        sweepAngle = 360f * progress,
                        useCenter = false,
                        topLeft = topLeft,
                        size = arcSize,
                        style = Stroke(stroke, cap = StrokeCap.Round),
                    )
                }
                if (!cameraReady) CircularProgressIndicator(color = Color.White, strokeWidth = 3.dp)
                if (recordingNow) {
                    Surface(
                        color = Color.Black.copy(alpha = .68f),
                        shape = RoundedCornerShape(50),
                        border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .16f)),
                        modifier = Modifier.align(Alignment.BottomStart).padding(start = 18.dp, bottom = 16.dp),
                    ) {
                        Row(Modifier.padding(horizontal = 10.dp, vertical = 6.dp), verticalAlignment = Alignment.CenterVertically) {
                            Box(Modifier.size(8.dp).clip(CircleShape).background(XRed))
                            Spacer(Modifier.width(6.dp))
                            Text(timerText, color = Color.White, fontSize = 14.sp, fontWeight = FontWeight.Bold)
                        }
                    }
                }
            }

            AnimatedVisibility(
                visible = recordingNow,
                enter = fadeIn(tween(180)) + slideInVertically(tween(220)) { it / 3 },
                exit = fadeOut(tween(140)) + slideOutVertically(tween(180)) { it / 3 },
                modifier = Modifier.align(Alignment.BottomEnd).padding(end = 26.dp, bottom = 140.dp),
            ) {
                Surface(
                    onClick = { locked = !locked },
                    color = if (locked) Color(0xFF315D86) else Color(0xFF24364A),
                    shape = RoundedCornerShape(21.dp),
                    border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .14f)),
                    modifier = Modifier.size(width = 58.dp, height = 70.dp),
                ) {
                    Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.Center) {
                        Icon(if (locked) Icons.Outlined.Lock else Icons.Outlined.LockOpen, "Зафиксировать запись", tint = Color.White, modifier = Modifier.size(26.dp))
                        Spacer(Modifier.height(4.dp))
                        Text(if (locked) "Готово" else "Замок", color = Color.White.copy(alpha = .74f), fontSize = 9.sp)
                    }
                }
            }

            Column(
                Modifier.align(Alignment.BottomCenter).fillMaxWidth().padding(horizontal = 14.dp, vertical = 10.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
            ) {
                AnimatedContent(
                    targetState = recordingNow,
                    transitionSpec = { fadeIn(tween(180)) togetherWith fadeOut(tween(120)) },
                    label = "video-record-guidance",
                ) { active ->
                    if (active) {
                        Surface(
                            color = Color(0xFF1C2A3A).copy(alpha = .96f),
                            shape = RoundedCornerShape(22.dp),
                            border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .12f)),
                            modifier = Modifier
                                .fillMaxWidth()
                                .graphicsLayer { translationX = swipeOffset }
                                .pointerInput(recording, locked) {
                                    if (!locked) {
                                        detectHorizontalDragGestures(
                                            onDragEnd = {
                                                if (swipeOffset <= -swipeCancelThreshold) stopAndDiscard()
                                                else swipeOffset = 0f
                                            },
                                            onDragCancel = { swipeOffset = 0f },
                                        ) { change, dragAmount ->
                                            change.consume()
                                            swipeOffset = (swipeOffset + dragAmount).coerceIn(-swipeCancelThreshold * 1.25f, 0f)
                                        }
                                    }
                                },
                        ) {
                            Row(
                                Modifier.fillMaxWidth().height(50.dp).padding(horizontal = 14.dp),
                                verticalAlignment = Alignment.CenterVertically,
                            ) {
                                Box(Modifier.size(10.dp).clip(CircleShape).background(XRed))
                                Spacer(Modifier.width(10.dp))
                                Text(timerText, color = Color.White, fontSize = 18.sp, fontWeight = FontWeight.Bold)
                                Spacer(Modifier.width(14.dp))
                                Text(
                                    if (locked) "Запись зафиксирована · нажмите ■ чтобы отправить" else "‹ Отмена   ·   ⌃ Вверх — зафиксировать",
                                    color = Color.White.copy(alpha = .80f),
                                    fontSize = 13.sp,
                                    modifier = Modifier.weight(1f),
                                    textAlign = TextAlign.End,
                                )
                            }
                        }
                    } else Spacer(Modifier.height(50.dp))
                }

                Spacer(Modifier.height(10.dp))
                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
                    Surface(
                        color = Color(0xFF1A2B3D).copy(alpha = .96f),
                        shape = RoundedCornerShape(24.dp),
                        border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .12f)),
                    ) {
                        Row(verticalAlignment = Alignment.CenterVertically) {
                            IconButton(
                                onClick = {
                                    lensFacing = if (lensFacing == CameraSelector.LENS_FACING_FRONT) CameraSelector.LENS_FACING_BACK else CameraSelector.LENS_FACING_FRONT
                                },
                                enabled = cameraReady,
                                modifier = Modifier.size(52.dp),
                            ) {
                                Icon(Icons.Outlined.Cameraswitch, "Сменить камеру", tint = if (cameraReady) Color.White else Color.White.copy(alpha = .30f))
                            }
                            Box(Modifier.width(1.dp).height(24.dp).background(Color.White.copy(alpha = .12f)))
                            IconButton(
                                onClick = { toggleTorch() },
                                enabled = lensFacing == CameraSelector.LENS_FACING_BACK && cameraReady,
                                modifier = Modifier.size(52.dp),
                            ) {
                                Icon(
                                    if (torchEnabled) Icons.Outlined.FlashOn else Icons.Outlined.FlashOff,
                                    "Вспышка",
                                    tint = if (lensFacing == CameraSelector.LENS_FACING_BACK && cameraReady) Color.White else Color.White.copy(alpha = .30f),
                                )
                            }
                        }
                    }

                    Spacer(Modifier.weight(1f))
                    Box(Modifier.size(98.dp), contentAlignment = Alignment.Center) {
                        if (recordingNow) {
                            Box(
                                Modifier
                                    .size(86.dp)
                                    .graphicsLayer {
                                        scaleX = recordPulse
                                        scaleY = recordPulse
                                        alpha = .30f
                                    }
                                    .clip(CircleShape)
                                    .background(Color(0xFFF04452)),
                            )
                        }
                        Surface(
                            onClick = { toggleRecording() },
                            enabled = cameraReady,
                            color = if (recordingNow) Color(0xFFD32F3A) else Color(0xFFF04452),
                            shape = CircleShape,
                            shadowElevation = 12.dp,
                            border = androidx.compose.foundation.BorderStroke(5.dp, Color.White.copy(alpha = .10f)),
                            modifier = Modifier.size(82.dp),
                        ) {
                            Box(contentAlignment = Alignment.Center) {
                                Icon(
                                    if (recordingNow) Icons.Outlined.Stop else Icons.Outlined.CameraAlt,
                                    if (recordingNow) "Завершить и отправить" else "Начать запись",
                                    tint = Color.White,
                                    modifier = Modifier.size(if (recordingNow) 34.dp else 38.dp),
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

