@Composable
private fun XUpdatesTab(api: SupabaseApi, session: CloudSession) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()

    // The published release lives in the app_releases table (same source the launch
    // update dialog uses). The old app_updates table is legacy and always empty now,
    // which is why this screen used to show "no updates" while the popup showed one.
    var release by remember { mutableStateOf<AppRelease?>(null) }
    var loading by remember { mutableStateOf(true) }
    var checking by remember { mutableStateOf(false) }
    var checkError by remember { mutableStateOf(false) }

    var downloading by remember { mutableStateOf(false) }
    var progress by remember { mutableStateOf(0f) }
    var errorText by remember { mutableStateOf<String?>(null) }

    suspend fun refresh(): Boolean = runCatching {
        withContext(Dispatchers.IO) { api.latestRelease(session.accessToken) }
    }.map { release = it; true }.getOrDefault(false)

    LaunchedEffect(session.accessToken) {
        checkError = !refresh()
        loading = false
    }

    val current = BuildConfig.VERSION_CODE
    val r = release
    val hasUpdate = r != null && r.versionCode > current

    Column(Modifier.fillMaxSize()) {
        LazyColumn(
            Modifier.weight(1f).fillMaxWidth(),
            contentPadding = PaddingValues(horizontal = 20.dp, vertical = 8.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp),
        ) {
            item { XSectionTitle(tr("system_updates"), xSettingText("updates_settings_sub")) }

            item { XCurrentVersionCard() }

            when {
                loading -> item { XLoadingCard() }
                checkError -> item { XInlineMessage(tr("updates_check_failed"), error = true) }
                hasUpdate -> item {
                    val rel = r!!
                    XUpdateAvailableCard(
                        release = rel,
                        downloading = downloading,
                        progress = progress,
                        errorText = errorText,
                        onDownload = {
                            if (!downloading) {
                                downloading = true; errorText = null; progress = 0f
                                scope.launch {
                                    val res = runCatching {
                                        val file = downloadApk(context, rel.apkUrl, rel.version) { progress = it }
                                        installApk(context, file)
                                    }
                                    downloading = false
                                    res.onFailure { e ->
                                        errorText = if (e is InstallPermissionRequired) tr("updates_allow_install")
                                        else e.message ?: tr("updates_download_failed")
                                    }
                                }
                            }
                        },
                    )
                }
                else -> item {
                    XIllustrationCard(
                        title = tr("updates_up_to_date"),
                        subtitle = tr("updates_up_to_date_sub"),
                        illustration = { CloudUpdateGlyph(160.dp) },
                    )
                }
            }
        }

        Button(
            onClick = {
                if (!checking && !downloading) {
                    checking = true; checkError = false
                    scope.launch {
                        checkError = !refresh()
                        checking = false
                    }
                }
            },
            enabled = !checking && !downloading,
            colors = ButtonDefaults.buttonColors(
                containerColor = XPurple,
                disabledContainerColor = XPurple.copy(alpha = .4f),
            ),
            shape = RoundedCornerShape(16.dp),
            modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 12.dp).height(52.dp),
        ) {
            if (checking) {
                CircularProgressIndicator(color = Color.White, strokeWidth = 2.dp, modifier = Modifier.size(20.dp))
                Spacer(Modifier.width(10.dp))
                Text(tr("updates_checking"), color = Color.White, fontWeight = FontWeight.Bold)
            } else {
                Icon(Icons.Outlined.Refresh, null, tint = Color.White, modifier = Modifier.size(20.dp))
                Spacer(Modifier.width(10.dp))
                Text(tr("updates_check"), color = Color.White, fontWeight = FontWeight.Bold)
            }
        }
    }
}

