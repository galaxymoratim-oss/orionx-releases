@Composable
private fun XSwipeConversationRow(
    conversation: CloudConversation,
    selected: Boolean,
    selectionMode: Boolean,
    archived: Boolean,
    onClick: () -> Unit,
    onLongClick: () -> Unit,
    onSwipeArchive: () -> Unit,
    currentUserId: String = "",
) {
    if (selectionMode) {
        XConversationRow(conversation, selected, onClick, onLongClick, currentUserId)
        return
    }
    val dismissState = rememberSwipeToDismissBoxState(
        positionalThreshold = { distance -> distance * .28f },
        confirmValueChange = { value ->
            if (value == SwipeToDismissBoxValue.StartToEnd) {
                onSwipeArchive()
            }
            false
        },
    )
    SwipeToDismissBox(
        state = dismissState,
        enableDismissFromStartToEnd = true,
        enableDismissFromEndToStart = false,
        backgroundContent = {
            Box(
                Modifier.fillMaxSize().clip(RoundedCornerShape(22.dp)).background(XPurple.copy(alpha = .23f)).padding(horizontal = 22.dp),
                contentAlignment = Alignment.CenterStart,
            ) {
                Icon(
                    if (archived) Icons.Outlined.Unarchive else Icons.Outlined.Archive,
                    if (archived) "Вернуть из архива" else "В архив",
                    tint = XViolet,
                    modifier = Modifier.size(25.dp),
                )
            }
        },
    ) {
        XConversationRow(conversation, selected, onClick, onLongClick, currentUserId)
    }
}

@Composable
private fun XConversationRow(
    conversation: CloudConversation,
    selected: Boolean,
    onClick: () -> Unit,
    onLongClick: () -> Unit,
    currentUserId: String = "",
) {
    val mineLast = conversation.lastMessageMine ||
        (conversation.lastMessageSenderId.isNotBlank() && conversation.lastMessageSenderId == currentUserId)
    val timeText = conversation.lastMessageAt.takeIf { it.isNotBlank() }?.let { formatMessageTime(it) }.orEmpty()
    Surface(
        color = if (selected) XPurple.copy(alpha = .17f) else XSurfaceSoft,
        shape = RoundedCornerShape(22.dp),
        border = androidx.compose.foundation.BorderStroke(1.dp, if (selected) XViolet else XBorder),
        modifier = Modifier.fillMaxWidth().combinedClickable(onClick = onClick, onLongClick = onLongClick),
    ) {
        Row(Modifier.padding(12.dp), verticalAlignment = Alignment.CenterVertically) {
            val displayTitle = if (conversation.type == "direct") conversation.peerDisplayName.ifBlank { conversation.title } else conversation.title
            val displayAvatar = if (conversation.type == "direct") conversation.peerAvatarUrl else conversation.avatarUrl
            if (displayAvatar.isNotBlank()) {
                RemoteImage(displayAvatar, Modifier.size(48.dp).clip(CircleShape), ContentScale.Crop)
            } else {
                XLetterAvatar(displayTitle, 48.dp)
            }
            Spacer(Modifier.width(11.dp))
            Column(Modifier.weight(1f)) {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Text(displayTitle, color = XText, fontWeight = FontWeight.SemiBold, fontSize = 16.sp, maxLines = 1, overflow = TextOverflow.Ellipsis, modifier = Modifier.weight(1f, fill = false))
                    if (timeText.isNotBlank()) {
                        Spacer(Modifier.width(8.dp))
                        Text(timeText, color = XMuted, fontSize = 11.sp, maxLines = 1)
                    }
                }
                val fallbackSubtitle = if (conversation.type == "direct" && conversation.peerNickname.isNotBlank()) "@${conversation.peerNickname}" else conversation.description.ifBlank {
                    when (conversation.type) {
                        "channel" -> if (conversation.isPublic) "Публичный канал" else "Частный канал"
                        "group" -> if (conversation.isPublic) "Публичная группа" else "Группа"
                        else -> "Личный чат"
                    }
                }
                val hasPreview = conversation.lastMessagePreview.isNotBlank()
                Row(verticalAlignment = Alignment.CenterVertically) {
                    if (mineLast && hasPreview) {
                        Icon(
                            if (conversation.lastMessageRead) Icons.Outlined.DoneAll else if (conversation.lastMessageDelivered) Icons.Outlined.DoneAll else Icons.Outlined.Done,
                            null,
                            tint = if (conversation.lastMessageRead) XCyan else XMuted,
                            modifier = Modifier.size(15.dp),
                        )
                        Spacer(Modifier.width(3.dp))
                        Text(tr("you_colon"), color = XMuted, fontSize = 12.sp, maxLines = 1)
                    }
                    Text(
                        conversation.lastMessagePreview.ifBlank { fallbackSubtitle },
                        color = XMuted,
                        fontSize = 12.sp,
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis,
                    )
                }
            }
            if (conversation.unreadCount > 0 && !selected) {
                Surface(
                    color = XPurple,
                    shape = CircleShape,
                    border = androidx.compose.foundation.BorderStroke(1.dp, Color.White.copy(alpha = .20f)),
                    modifier = Modifier.defaultMinSize(minWidth = 27.dp, minHeight = 27.dp),
                ) {
                    Box(contentAlignment = Alignment.Center, modifier = Modifier.padding(horizontal = 7.dp, vertical = 4.dp)) {
                        Text(
                            if (conversation.unreadCount > 99) "99+" else conversation.unreadCount.toString(),
                            color = Color.White,
                            fontSize = 10.sp,
                            fontWeight = FontWeight.Bold,
                        )
                    }
                }
                Spacer(Modifier.width(7.dp))
            }
            if (selected) {
                Surface(color = XPurple, shape = CircleShape, modifier = Modifier.size(26.dp)) {
                    Box(contentAlignment = Alignment.Center) { Icon(Icons.Outlined.Check, null, tint = Color.White, modifier = Modifier.size(18.dp)) }
                }
            } else {
                Icon(Icons.Outlined.ChevronRight, null, tint = XMuted, modifier = Modifier.size(19.dp))
            }
        }
    }
}

@Composable
private fun XSearchTab(api: SupabaseApi, session: CloudSession, onOpen: (CloudConversation) -> Unit) {
    var query by remember { mutableStateOf("") }
    var users by remember { mutableStateOf<List<CloudProfile>>(emptyList()) }
    var channels by remember { mutableStateOf<List<CloudConversation>>(emptyList()) }
    var loading by remember { mutableStateOf(false) }
    var error by remember { mutableStateOf<String?>(null) }
    val scope = rememberCoroutineScope()

    LaunchedEffect(query, session.accessToken) {
        if (query.trim().isEmpty()) {
            users = emptyList(); channels = emptyList(); loading = false; error = null
            return@LaunchedEffect
        }
        delay(300)
        loading = true
        val result = withContext(Dispatchers.IO) {
            runCatching { api.searchProfiles(session.accessToken, query) to api.searchChannels(session.accessToken, query) }
        }
        result.onSuccess { users = it.first.filterNot { user -> user.id == session.userId }; channels = it.second; error = null }.onFailure { error = localizedNetworkError(it) }
        loading = false
    }

    Column(Modifier.fillMaxSize().padding(horizontal = 20.dp)) {
        XSearchField(query, { query = it }, Modifier.padding(top = 8.dp))
        Spacer(Modifier.height(14.dp))
        when {
            query.isBlank() -> XHeroEmptyState(
                title = xSettingText("find_users"),
                subtitle = tr("search_hint"),
                illustration = { SearchOrb(182.dp) },
                modifier = Modifier.weight(1f),
            )
            loading -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator(color = XPurple) }
            users.isEmpty() && channels.isEmpty() -> XHeroEmptyState(
                title = xSettingText("nothing_found"),
                subtitle = xSettingText("change_query"),
                illustration = { SearchOrb(150.dp) },
                modifier = Modifier.weight(1f),
            )
            else -> LazyColumn(
                Modifier.fillMaxSize(),
                contentPadding = PaddingValues(bottom = 24.dp),
                verticalArrangement = Arrangement.spacedBy(10.dp),
            ) {
                if (users.isNotEmpty()) {
                    item { XMiniTitle(tr("people")) }
                    items(users, key = { it.id }) { user ->
                        XUserSearchRow(user) {
                            scope.launch {
                                runCatching { withContext(Dispatchers.IO) { api.createDirect(session.accessToken, user.id) } }
                                    .onSuccess { conversation -> onOpen(conversation) }
                                    .onFailure { error = localizedNetworkError(it) }
                            }
                        }
                    }
                }
                if (channels.isNotEmpty()) {
                    item { XMiniTitle(xSettingText("groups_channels")) }
                    items(channels, key = { it.id }) { channel ->
                        XChannelSearchRow(channel) {
                            scope.launch {
                                runCatching { withContext(Dispatchers.IO) { api.joinChannel(session.accessToken, channel.id); channel } }
                                    .onSuccess { conversation -> onOpen(conversation) }
                                    .onFailure { error = localizedNetworkError(it) }
                            }
                        }
                    }
                }
                error?.let { item { XInlineMessage(it, true) } }
            }
        }
    }
}

