@Composable
private fun XContactsTab(api: SupabaseApi, session: CloudSession, onOpen: (CloudConversation) -> Unit) {
    var contacts by remember(session.userId) { mutableStateOf<List<CloudConversation>>(emptyList()) }
    var query by remember(session.userId) { mutableStateOf("") }
    var loading by remember(session.userId) { mutableStateOf(true) }
    var error by remember(session.userId) { mutableStateOf<String?>(null) }

    LaunchedEffect(session.accessToken, session.userId) {
        loading = true
        runCatching { withContext(Dispatchers.IO) { api.myConversations(session.accessToken, session.userId) } }
            .onSuccess { rows ->
                contacts = rows
                    .filter { it.type == "direct" && !it.archived }
                    .distinctBy { it.id }
                    .sortedBy { it.peerDisplayName.ifBlank { it.title }.lowercase() }
                error = null
            }
            .onFailure { error = localizedNetworkError(it) }
        loading = false
    }

    val visibleContacts = remember(contacts, query) {
        val needle = query.trim().removePrefix("@").lowercase()
        if (needle.isBlank()) contacts
        else contacts.filter { conversation ->
            conversation.peerDisplayName.lowercase().contains(needle) ||
                conversation.peerNickname.lowercase().contains(needle) ||
                conversation.title.lowercase().contains(needle)
        }
    }

    Column(Modifier.fillMaxSize().padding(horizontal = 20.dp)) {
        XSectionTitle(tr("contacts"), "Личные диалоги и сохранённые контакты")
        XSearchField(query, { query = it }, Modifier.padding(top = 8.dp), placeholder = tr("contacts_search_hint"))
        Spacer(Modifier.height(12.dp))
        Box(Modifier.weight(1f).fillMaxWidth()) {
            when {
                loading -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                    CircularProgressIndicator(color = XPurple)
                }
                contacts.isEmpty() && error != null -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.TopCenter) {
                    XInlineMessage(error.orEmpty(), error = true)
                }
                visibleContacts.isEmpty() -> XHeroEmptyState(
