@Composable
private fun XVoiceMessagePlayer(url: String, onFallbackOpen: () -> Unit) {
    val player = remember(url) { MediaPlayer() }
    var prepared by remember(url) { mutableStateOf(false) }
    var playing by remember(url) { mutableStateOf(false) }
    var durationMs by remember(url) { mutableIntStateOf(0) }
    var positionMs by remember(url) { mutableIntStateOf(0) }
    var failed by remember(url) { mutableStateOf(false) }

    DisposableEffect(url) {
        val result = runCatching {
            player.setDataSource(url)
            player.setOnPreparedListener { mp ->
                prepared = true
                durationMs = mp.duration.coerceAtLeast(0)
            }
            player.setOnCompletionListener { mp ->
                playing = false
                positionMs = 0
                runCatching { mp.seekTo(0) }
            }
            player.setOnErrorListener { _, _, _ ->
                failed = true
                prepared = false
                playing = false
                true
            }
            player.prepareAsync()
        }
        if (result.isFailure) failed = true
        onDispose { runCatching { player.release() } }
    }

    LaunchedEffect(playing) {
        while (playing && prepared) {
            positionMs = runCatching { player.currentPosition }.getOrDefault(positionMs)
            delay(180)
        }
    }

    Surface(
        color = Color.Black.copy(alpha = .16f),
        shape = RoundedCornerShape(18.dp),
        border = androidx.compose.foundation.BorderStroke(1.dp, XBorder),
        modifier = Modifier.widthIn(min = 210.dp, max = 280.dp),
    ) {
        Row(Modifier.padding(horizontal = 10.dp, vertical = 9.dp), verticalAlignment = Alignment.CenterVertically) {
            Surface(
                color = XViolet.copy(alpha = .20f),
                shape = CircleShape,
                modifier = Modifier.size(40.dp).clickable {
                    if (failed) {
                        onFallbackOpen()
                    } else if (prepared) {
                        runCatching {
                            if (player.isPlaying) {
                                player.pause()
                                playing = false
                            } else {
                                player.start()
                                playing = true
                            }
                        }.onFailure { failed = true }
                    }
                },
            ) {
                Box(contentAlignment = Alignment.Center) {
                    when {
                        failed -> Icon(Icons.Outlined.OpenInNew, null, tint = XText, modifier = Modifier.size(20.dp))
                        !prepared -> CircularProgressIndicator(color = XViolet, strokeWidth = 2.dp, modifier = Modifier.size(19.dp))
                        playing -> Icon(Icons.Outlined.Pause, null, tint = XText, modifier = Modifier.size(22.dp))
                        else -> Icon(Icons.Outlined.PlayArrow, null, tint = XText, modifier = Modifier.size(24.dp))
                    }
                }
            }
            Spacer(Modifier.width(9.dp))
            Column(Modifier.weight(1f)) {
                Text("Голосовое сообщение", color = XText, fontSize = 12.sp, fontWeight = FontWeight.SemiBold)
                Spacer(Modifier.height(5.dp))
                LinearProgressIndicator(
                    progress = { if (durationMs > 0) (positionMs.toFloat() / durationMs.toFloat()).coerceIn(0f, 1f) else 0f },
                    color = XViolet,
                    trackColor = XBorder,
                    modifier = Modifier.fillMaxWidth().height(3.dp).clip(CircleShape),
                )
                Spacer(Modifier.height(4.dp))
                Text(
                    if (failed) "Открыть во внешнем проигрывателе" else "${formatMediaDuration(positionMs)} / ${formatMediaDuration(durationMs)}",
                    color = XMuted,
                    fontSize = 9.sp,
                )
            }
        }
    }
}

